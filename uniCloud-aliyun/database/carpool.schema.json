{
  "bsonType": "object",
  "required": ["type", "fromLocation", "toLocation", "departureTime", "userId", "contact"],
  "permission": {
    "read": true,
    "create": "auth.uid != null",
    "update": "doc.userId == auth.uid",
    "delete": "doc.userId == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "type": {
      "bsonType": "string",
      "description": "类型：offer-车找人，request-人找车",
      "enum": ["offer", "request"]
    },
    "fromLocation": {
      "bsonType": "string",
      "description": "出发地"
    },
    "toLocation": {
      "bsonType": "string",
      "description": "目的地"
    },
    "departureTime": {
      "bsonType": "string",
      "description": "出发时间"
    },
    "seats": {
      "bsonType": "int",
      "description": "座位数（车找人时必填）"
    },
    "contact": {
      "bsonType": "object",
      "required": ["name"],
      "description": "联系方式",
      "properties": {
        "name": {
          "bsonType": "string",
          "description": "联系人姓名"
        },
        "phone": {
          "bsonType": "string",
          "description": "联系电话"
        },
        "wechat": {
          "bsonType": "string",
          "description": "微信号"
        }
      }
    },
    "userId": {
      "bsonType": "string",
      "description": "发布用户ID",
      "foreignKey": "users._id"
    },
    "status": {
      "bsonType": "string",
      "description": "状态：active-进行中，expired-已过期，cancelled-已取消",
      "enum": ["active", "expired", "cancelled"],
      "default": "active"
    },
    "viewCount": {
      "bsonType": "int",
      "description": "浏览次数",
      "default": 0
    },
    "remark": {
      "bsonType": "string",
      "description": "备注信息"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "updateTime": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
